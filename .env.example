# Axiora Pulse — backend environment
#
# Copy to .env and fill in. On the dev EC2 box this file is NOT hand-written:
# deploy.sh renders it from SSM Parameter Store under /axiora/dev/.
#
# Every key below corresponds to an os.getenv() call in the codebase.

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Axiora Pulse AI Engine"
APP_VERSION=1.0.0
# true keeps /docs and /redoc enabled (main.py gates docs_url on this).
DEBUG=true
# Comma-separated. Irrelevant when the SPA and API share an origin behind Caddy.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# MUST use the +asyncpg driver — app/db/database.py builds an async engine.
# WARNING: the app runs `alembic upgrade head` at every startup. Point this at a
# dev database only. Never at axiora-db (prod).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/axiora_dev_db

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# The in-code fallback is a public placeholder — always override it.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=10

# ── LLM provider ──────────────────────────────────────────────────────────────
# One of: huggingface | openai | anthropic
DEFAULT_PROVIDER=huggingface
DEFAULT_MODEL=meta-llama/Llama-3.1-8B-Instruct

HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_TIMEOUT=120
HF_MAX_RETRIES=2

OPENAI_API_KEY=
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

ANTHROPIC_API_KEY=

# ── SMTP (OTP + password-reset emails) ────────────────────────────────────────
# Gmail requires an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Axiora Pulse"
